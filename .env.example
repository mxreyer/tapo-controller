# TP-Link cloud account credentials (the same ones you use in the Tapo app).
# Required: the plugs do local control but authenticate against these. They are
# never sent to TP-Link by this app.
TAPO_USERNAME=you@example.com
TAPO_PASSWORD=your-tapo-password

# Comma-separated plug IPs. Recommended: give each plug a DHCP reservation.
# Leave empty to rely on broadcast discovery (needs network_mode: host).
# Plugs listed in servers.json are added automatically.
TAPO_HOSTS=192.168.1.50,192.168.1.51

# Set to false to disable broadcast discovery on startup / "Scan" button.
# Required if the container is not on the host network — broadcast cannot
# escape a bridge or a VPN sidecar's namespace.
TAPO_DISCOVERY=true

# Which plugs power a machine that must be shut down gracefully.
TAPO_SERVERS_FILE=/config/servers.json
# Alternatively, inline JSON here instead of a file (takes precedence):
# TAPO_SERVERS={"192.168.1.50":{"ssh_host":"192.168.1.20","ssh_user":"max"}}

# known_hosts file for the shutdown SSH connection.
SSH_KNOWN_HOSTS=/ssh/known_hosts

# Listening port. Change if 8080 is taken on the host.
# APP_PORT=8080

# Optional HTTP basic auth for the UI. Leave blank to disable.
WEB_USERNAME=
WEB_PASSWORD=
